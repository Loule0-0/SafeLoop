{
  "release": "openvla_oft_decider_v2",
  "paper": "SafeLoop: Risk-Aware Rollback for Vision-Language-Action Manipulation",
  "base_policy": {
    "name": "OpenVLA-OFT",
    "checkpoint": "moojink/openvla-7b-oft-finetuned-libero-spatial-object-goal-10",
    "action_chunk_size": 8,
    "training_suite": "libero_90"
  },
  "decision_head": {
    "initial_checkpoint": "decision_heads/g6_safeanchor_update004.pt",
    "expected_checkpoint": "online_decider_update001.pt"
  },
  "recipe": {
    "name": "openvla_oft_libero90_safe_anchor_ppo",
    "summary": "OpenVLA-OFT decider training on the seven paper LIBERO-90 tasks while reusing the released predictor.",
    "args": {
      "policy-backend": "openvla-oft",
      "policy-mode": "websocket",
      "policy-host": "${policy_host}",
      "policy-port": "${policy_port}",
      "benchmark": "libero_90",
      "task-ids": [
        0,
        28,
        30,
        32,
        37,
        71,
        84
      ],
      "seed": 7101,
      "predictor": "qwen-multitask",
      "qwen-model-path": "${model_dir}",
      "qwen-head-path": "${weights_dir}/prediction_heads/v23_success_balanced_step1000_multitask_head.pt",
      "qwen-dtype": "bfloat16",
      "future-window": 100,
      "decision-interval": 20,
      "initial-decision-checkpoint": "${weights_dir}/decision_heads/g6_safeanchor_update004.pt",
      "initial-actor-logit-scale": 0.25,
      "decision-device": "cpu",
      "replan-steps": 8,
      "max-rollout-steps": 400,
      "rollback-mode": "motion-plan",
      "motion-execution-mode": "kinematic",
      "max-joint-step": 0.08,
      "max-steps-per-waypoint": 2,
      "kinematic-substeps-per-waypoint": 2,
      "allow-restore-fallback": true,
      "record-probability": 0.14,
      "record-max-risk-score": 1.01,
      "record-max-current-body-probability": 0.44,
      "record-max-current-object-probability": 1.01,
      "rollback-probability": 0.45,
      "rollback-tth": 0.8,
      "min-record-interval": 20,
      "rollback-cooldown": 60,
      "record-exploration-probability": 0.0,
      "rollback-exploration-probability": 0.7,
      "noop-exploration-probability": 0.15,
      "min-rollback-step": 30,
      "max-rollbacks-per-episode": 2,
      "stuck-fallback": true,
      "stuck-window-steps": 70,
      "stuck-min-low-motion-steps": 50,
      "stuck-max-step-displacement": 0.0025,
      "stuck-max-window-displacement": 0.025,
      "rollback-gate-allow-stuck-object-override": true,
      "stuck-rollback-target-max-age": 320,
      "rollback-gate-current-threshold": 1.01,
      "rollback-gate-current-body-threshold": 0.15,
      "rollback-gate-current-object-threshold": 0.9,
      "rollback-gate-max-current-object-probability": 1.01,
      "rollback-gate-future-probability": 1.01,
      "rollback-gate-future-body-probability": 0.4,
      "rollback-gate-future-object-probability": 0.92,
      "rollback-gate-future-tth": 0.8,
      "rollback-gate-future-object-tth": 0.18,
      "rollback-target-safe-score-threshold": 0.7,
      "rollback-target-min-age": 30,
      "rollback-target-max-age": 200,
      "record-initial-safe-anchor": true,
      "updates": 2,
      "total-schedule-updates": 8,
      "episodes-per-update": 1,
      "ppo-epochs": 12,
      "lr": 0.00003,
      "actor-lr": 0.0001,
      "critic-lr": 0.00003,
      "entropy-coef": 0.02,
      "bc-coef": 1.0,
      "class-balanced-bc": true,
      "bc-anneal-fraction": 1.0,
      "hazard-penalty": -0.06,
      "hazard-onset-penalty": -8.0,
      "predictor-onset-penalty": 0.0,
      "body-hazard-penalty": -0.75,
      "object-hazard-penalty": -0.25,
      "stuck-hazard-penalty": -0.5,
      "rollback-penalty": -0.1,
      "rollback-failure-penalty": -9.0,
      "rollback-rendered-frame-penalty": -0.0012,
      "rollback-resolved-bonus": 6.0,
      "rollback-preemptive-bonus": 1.0,
      "rollback-unresolved-penalty": -10.0,
      "rollback-effect-horizon": 80,
      "rollback-episode-success-bonus": 5.0,
      "rollback-episode-failure-penalty": -1.0,
      "noop-effect-horizon": 120,
      "noop-probe-blocks-rollback": true,
      "noop-safe-bonus": 1.0,
      "noop-hazard-penalty": -2.0,
      "record-penalty": -0.0012,
      "step-penalty": -0.0006,
      "completion-reward": 20.0,
      "task-reward-scale": 2.0,
      "qwen-rollout-stride": 20,
      "qwen-rollout-prehazard-stride": 5,
      "out-dir": "${output_root}/decision_heads/openvla_oft_libero90"
    }
  }
}
