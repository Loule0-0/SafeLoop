{
  "release": "pi0-v1",
  "huggingface": {
    "weights_repo": "Jaqen0-0/SafeLoop",
    "weights_revision": "pi0-v1",
    "dataset_repo": "Jaqen0-0/SafeLoop-Training-Data"
  },
  "decision_head": {
    "release_checkpoint": "decision_heads/g6_safeanchor_update004.pt",
    "initial_checkpoint": "decision_heads/init_g4_success_bodygate_update000.pt"
  },
  "reward": {
    "completion_reward": 10.0,
    "task_reward_scale": 1.0,
    "hazard_penalty": -0.12,
    "body_hazard_penalty": -2.0,
    "object_hazard_penalty": 0.0,
    "stuck_hazard_penalty": -3.0,
    "rollback_failure_penalty": -9.0,
    "rollback_rendered_frame_penalty": -0.0012,
    "rollback_resolved_bonus": 10.0,
    "rollback_unresolved_penalty": -8.0,
    "rollback_episode_success_bonus": 4.0,
    "rollback_episode_failure_penalty": -5.5,
    "record_penalty": -0.0012,
    "step_penalty": -0.0006
  },
  "recipe": {
    "name": "g6_safeanchor_online_rl",
    "summary": "Online three-action decision-head training used for the release SafeLoop controller.",
    "expected_checkpoint": "online_decider_update004.pt",
    "args": {
      "policy-mode": "websocket",
      "policy-host": "${policy_host}",
      "policy-port": "${policy_port}",
      "benchmark": "libero_10",
      "task-ids": [
        8,
        8,
        6,
        9,
        8,
        6,
        9
      ],
      "seed": 603,
      "predictor": "qwen-multitask",
      "qwen-model-path": "${model_dir}",
      "qwen-head-path": "${weights_dir}/prediction_heads/v9_object_recall_step3500_multitask_head.pt",
      "future-window": 100,
      "decision-interval": 20,
      "initial-decision-checkpoint": "${weights_dir}/decision_heads/init_g4_success_bodygate_update000.pt",
      "decision-device": "cpu",
      "rollback-mode": "motion-plan",
      "motion-execution-mode": "kinematic",
      "max-joint-step": 0.08,
      "max-steps-per-waypoint": 2,
      "kinematic-substeps-per-waypoint": 2,
      "allow-restore-fallback": true,
      "record-probability": 0.12,
      "record-max-risk-score": 1.01,
      "rollback-probability": 0.55,
      "rollback-tth": 0.35,
      "min-record-interval": 20,
      "rollback-cooldown": 15,
      "rollback-gate-current-threshold": 1.01,
      "rollback-gate-future-probability": 1.01,
      "rollback-target-safe-score-threshold": 0.6,
      "rollback-target-min-age": 30,
      "rollback-target-max-age": 120,
      "updates": 8,
      "episodes-per-update": 1,
      "ppo-epochs": 4,
      "lr": 5e-06,
      "bc-anneal-fraction": 0.8,
      "hazard-penalty": -0.12,
      "body-hazard-penalty": -2.0,
      "stuck-hazard-penalty": -3.0,
      "rollback-failure-penalty": -9.0,
      "rollback-rendered-frame-penalty": -0.0012,
      "rollback-resolved-bonus": 10.0,
      "rollback-unresolved-penalty": -8.0,
      "rollback-effect-horizon": 60,
      "rollback-episode-success-bonus": 4.0,
      "rollback-episode-failure-penalty": -5.5,
      "record-penalty": -0.0012,
      "step-penalty": -0.0006,
      "completion-reward": 10.0,
      "task-reward-scale": 1.0,
      "qwen-rollout-stride": 20,
      "qwen-rollout-prehazard-stride": 5,
      "out-dir": "${output_root}/decision_heads/g6_safeanchor_online_rl"
    }
  }
}
